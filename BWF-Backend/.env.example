PORT=5000

# Atlas connection string (recommended for shared environments)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Local fallback DB (useful during offline or local-first development)
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/bwf_local

# true -> force local DB, false -> use Atlas if MONGO_URI exists, else local
PREFER_LOCAL_DB=false

ACCESS_TOKEN_SECRET=replace_with_strong_access_secret
REFRESH_TOKEN_SECRET=replace_with_strong_refresh_secret
CLIENT_URL=http://localhost:3000
